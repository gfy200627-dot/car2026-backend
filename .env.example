# ===== 数据库 =====
# 本地开发示例：mysql+pymysql://user:password@127.0.0.1:3306/car2026?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/car2026?charset=utf8mb4

# ===== 安全 =====
# JWT 密钥：生产环境必须更换为随机长字符串（openssl rand -hex 32）
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM=HS256

# ===== CORS =====
# 允许的前端来源，逗号分隔；生产环境配置真实域名
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 应用 =====
APP_ENV=development
API_PREFIX=/api
# 数据时间轴（最近一个完整月）
LATEST_YEAR=2026
LATEST_MONTH=8
